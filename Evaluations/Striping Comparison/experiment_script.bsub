#!/bin/bash
#SBATCH -N 32
#SBATCH -p pbatch
#SBATCH -t 180
USERNAME=ather1

export HDF5_HOME=/p/lustre2/ather1/hdf5-1.14.4-3/install
export LD_LIBRARY_PATH=/p/lustre2/ather1/hdf5-1.14.4-3/install/lib:$LD_LIBRARY_PATH
export RECORDER_INTRAPROCESS_PATTERN_RECOGNITION=1
module load gcc/11.2.1

for i in 8 16 32 64 128 256; do
	# for j in 1 2 3 4 5; do	
	# 	srun -n 512 --export=ALL,LD_PRELOAD=/usr/workspace/ather1/Recorder_analysis/Recorder/install/lib/librecorder.so /p/lustre3/ather1/ior/install/bin/ior -a HDF5 -b ${i}m -i 5 -w -t 4m -e -m -o /p/lustre3/ather1/final_experiments/IOR/testFile &>> /p/lustre3/ather1/final_experiments/IOR/output_${i}m_16_ps_default.txt
	# done
	lfs setstripe -E4M -c1 -E128M -c4 -E-1 -c-1 /p/lustre3/ather1/final_experiments/IOR_Lustre
	for j in 1 2 3 4 5; do	
		srun -n 1024 --export=ALL,LD_PRELOAD=/usr/workspace/ather1/Recorder_analysis/Recorder/install/lib/librecorder.so /p/lustre3/ather1/ior/install/bin/ior -a HDF5 -b ${i}m -i 5 -w -t 4m -e -m &>> output_${i}m_16_ps.txt
	done

	lfs setstripe -c -1 /p/lustre3/ather1/final_experiments/IOR_Lustre
	for j in 1 2 3 4 5; do	
		srun -n 1024 --export=ALL,LD_PRELOAD=/usr/workspace/ather1/Recorder_analysis/Recorder/install/lib/librecorder.so /p/lustre3/ather1/ior/install/bin/ior -a HDF5 -b ${i}m -i 5 -w -t 4m -e -m &>> output_${i}m_16_ts.txt
	done
done
